# Copie este archivo como .env (Docker / producción) o .env.local (desarrollo)
# y ponga sus valores reales. Nunca suba el archivo con valores reales.

# ---------------------------------------------------------------------------
# Públicas: se incrustan en el JavaScript del navegador al compilar.
# En Docker llegan como build args (docker-compose las toma de este .env):
# si cambian, hay que reconstruir la imagen.
# ---------------------------------------------------------------------------

# URL PÚBLICA de Supabase (la que sirve Caddy por HTTPS). El servidor usa la
# misma, no la interna de Docker, para que coincida la cookie de sesión.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tudominio.com

# Anon key del Supabase self-hosted (ANON_KEY en su docker/.env).
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL pública de esta app, sin "/" final. Se usa para los redirects del login.
# Obligatoria en producción. En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://trivia.tudominio.com

# ---------------------------------------------------------------------------
# Solo servidor (runtime). Nunca les ponga el prefijo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Service role key del Supabase self-hosted (SERVICE_ROLE_KEY en su docker/.env).
# Ignora RLS: la usa solo el servidor para partidas, puntajes y la cuota de IA.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# API key de Google AI Studio, para generar preguntas con IA.
GEMINI_API_KEY=tu-api-key-de-gemini

# Modelo de Gemini (por defecto gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# Generaciones con IA por admin y por día (por defecto 10).
IA_LIMITE_DIARIO=10
