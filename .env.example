# Copie este archivo como .env.local (o .env) y ponga sus valores reales.
# Los encuentra en Supabase → Project Settings → Data API (URL) y → API Keys (anon public).
# También necesita una clave de API de Gemini.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Solo servidor: nunca le ponga el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
GEMINI_API_KEY=AQ.tu-api-key-aqui